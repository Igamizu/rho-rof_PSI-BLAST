#!/bin/bash
#PBS -q medium
#PBS -l ncpus=6
#PBS -l mem=24gb
set -euo pipefail
cd ${PBS_O_WORKDIR}

INDIR="results/rof/20230504-20_mts4000_BLOSUM45/last-iteration"
INPUT="mts4000_BLOSUM45_hit-header.txt"

DB="db/chosen-bacteria_CDS_nucleotide_exDup"

OUTDIR="hits-fasta"
OUTPUT="putative-rof_mts4000_BLOSUM45_nucleotide.fasta"

blastdbcmd -db $DB -entry_batch $INDIR"/"$INPUT > $OUTDIR"/"$OUTPUT

